{
  "name": "cineflow-ai",
  "productName": "CineFlow AI",
  "version": "1.0.1",
  "description": "CineFlow AI - Cinematic AI Video Production Studio powered by Electron, Next.js, AGY CLI, Google Flow, and Meta Suite",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"NEXT,ELECTRON\" -c \"cyan.bold,magenta.bold\" \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "next dev -p 3000",
    "dev:electron": "npm run build:electron && wait-on tcp:3000 && electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "next build",
    "build": "npm run build:electron && npm run build:renderer",
    "package": "npm run build && electron-builder",
    "lint": "next lint"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "electron-store": "^10.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.2",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  }
}
